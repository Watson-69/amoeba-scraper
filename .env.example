# amoeba-scraper Configuration
# Copy this file to .env.local and fill in your values

# MySQL Database
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=amoeba_scraper

# Optional: Cron secret for securing the /api/cron/sync endpoint
# CRON_SECRET=your-secure-random-string

# Optional: Scraper settings
# SCRAPER_DELAY_MS=900
# SCRAPER_TIMEOUT_MS=20000
# SCRAPER_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36